{
  "sealed_content_type": "application/morse-sealed",
  "max_keys": 4,
  "sealed_patterns": [
    "POST /v1/chat/completions",
    "POST /v1/chat/compact",
    "POST /v1/images/generations",
    "POST /v1/videos",
    "GET /v1/videos/{id}/content",
    "POST /v1/search",
    "POST /v1/fetch",
    "POST /v1/research",
    "GET /v1/research/{id}",
    "GET /v1/research/{id}/events",
    "GET /v1/lookup/{service}/{path...}",
    "POST /v1/audio/transcriptions",
    "POST /v1/plugins/call",
    "POST /v1/plugins/token",
    "POST /v1/plugins/revoke"
  ],
  "plain_patterns": [
    "GET /v1/models",
    "GET /v1/attestation",
    "GET /v1/receipts/{id}",
    "GET /v1/videos/{id}"
  ],
  "content_headers": [
    "Content-Type",
    "X-E2EE-Version",
    "X-E2EE-Nonce",
    "X-E2EE-Timestamp",
    "X-E2EE-Algo",
    "X-Client-Pub-Key",
    "X-Model-Pub-Key",
    "X-Signing-Algo",
    "X-Encryption-Version",
    "X-Encrypt-All-Fields",
    "Ehbp-Encapsulated-Key",
    "X-Tinfoil-Model",
    "X-Tinfoil-Max-Output-Tokens"
  ],
  "dropped_headers": [
    "authorization",
    "accept",
    "user-agent",
    "x-stainless-*",
    "openai-*",
    "content-length",
    "host",
    "connection",
    "keep-alive",
    "transfer-encoding"
  ],
  "relay_reply_headers": [
    "X-Request-Id",
    "X-Funding",
    "X-Included-Lane",
    "X-Included-Lane-Until",
    "X-Included-Until",
    "X-Output-Limited",
    "X-Turn-Remaining"
  ],
  "null_body_statuses": [
    204,
    205,
    304
  ]
}
